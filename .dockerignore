# Keep the build context small and keep secrets out of the image.
.git
.github
.dist
.env
.env.*
!.env.example

# Host-built dependencies and caches (the Dockerfile installs its own)
**/node_modules
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
frontend/dist
frontend/.vite
*.tsbuildinfo

# Runtime data, evidence screenshots and local artefacts
data
*.db
*.db-wal
*.db-shm
docs/evidence
*.patch
