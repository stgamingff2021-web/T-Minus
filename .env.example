# T-Minus environment — names only. Copy to .env and fill in. Never commit .env.
ENV=development                 # production enforces SECRET_KEY
SECRET_KEY=                     # >= 32 random chars (signs officer sessions + publish confirmations)
OFFICER_PASSCODE=               # shared passcode -> role "officer"
ADMIN_PASSCODE=                 # shared passcode -> role "admin" (chaos switch, delete plans)
CORS_ORIGINS=http://localhost:5173
# Transport security: redirect HTTP -> HTTPS and send HSTS. Default: on in production, off in development.
FORCE_HTTPS=
TRUST_PROXY_HEADERS=true        # read X-Forwarded-Proto from a TLS-terminating proxy (set false if exposed directly)
# Tip: `python -m scripts.init_env` (from backend/) writes a .env with random SECRET_KEY and passcodes.
# Keep SECRET_KEY stable: it also seals the page URLs, so changing it invalidates existing bookmarks.

# Database (default: SQLite file under DATA_DIR). Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/tminus
DATABASE_URL=
DATA_DIR=

# Agent LLM — one provider-agnostic interface, primary + backup (spec §9.4).
# Set either key (or both: Claude primary, Gemini backup). Without any key the planner runs
# in retrieval-only mode and says "temporarily unavailable"; scanner, triggers and map keep working.
LLM_PROVIDER=auto               # auto | anthropic | gemini
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_BACKUP_MODEL=claude-sonnet-5-5
LLM_EFFORT=high
GEMINI_API_KEY=                 # Google AI Studio key (sent as x-goog-api-key header)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BACKUP_MODEL=gemini-flash-lite-latest

# Scheduler
SCHEDULER_ENABLED=true
SCAN_INTERVAL_MIN=60
SCAN_ON_STARTUP=true
AUTO_PLAN_MIN_LEVEL=PREPARE     # agent runs automatically for triggers at/above this level

# Live sources (defaults are the public endpoints; all free tiers)
ENSEMBLE_MODELS=ecmwf_ifs025,gfs025
SACHET_FEED_URL=                # (verify) state/national CAP RSS feed URL from sachet.ndma.gov.in
ORS_API_KEY=                    # free openrouteservice key (safe routes); optional
CONTACT_EMAIL=                  # sent in the User-Agent (Nominatim usage policy)
OPEN_METEO_API_KEY=             # optional commercial key; free tier needs none
IMD_ENABLED=false               # IMD APIs need IP whitelisting; optional
USE_OS_TRUST_STORE=true         # verify HTTPS like your browser (OS trust store); false = certifi only

# Retrieval
EMBEDDING_BACKEND=auto          # auto | fastembed | tfidf
MAX_UPLOAD_MB=30

# Frontend (only when the dashboard is hosted separately, e.g. on Vercel)
VITE_API_BASE=
